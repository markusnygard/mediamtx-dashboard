# MediaMTX Dashboard Environment Variables
# Copy this file to .env and update the values

# Browser-facing MediaMTX API URL.
# The default goes through the dashboard's same-origin API proxy.
NEXT_PUBLIC_MEDIAMTX_API_URL=/api/mediamtx

# Server-side MediaMTX API URL used by the dashboard proxy.
MEDIAMTX_API_URL=http://publisher:9997

# MediaMTX HLS URL (for video streaming)
NEXT_PUBLIC_MEDIAMTX_HLS_URL=http://localhost/hls

# Public host used to build SRT/RTMP/RTSP connection URLs shown in each path's
# URL popup. Example: NEXT_PUBLIC_MEDIAMTX_HOST=91.229.137.199
NEXT_PUBLIC_MEDIAMTX_HOST=

# Protocol ports used when building connection URLs (defaults match MediaMTX).
NEXT_PUBLIC_MEDIAMTX_SRT_PORT=8890
NEXT_PUBLIC_MEDIAMTX_RTMP_PORT=1935
NEXT_PUBLIC_MEDIAMTX_RTSP_PORT=8554
NEXT_PUBLIC_MEDIAMTX_HLS_PORT=8888

# Grafana URL opened in the Monitoring tab popup (e.g. http://91.229.137.199:3001).
# Leave empty to use the same-origin /api/grafana proxy (works when port 3001
# is firewalled). Set NEXT_PUBLIC_GRAFANA_PROXY=0 to disable the proxy fallback.
NEXT_PUBLIC_GRAFANA_URL=
NEXT_PUBLIC_GRAFANA_PROXY=1

# Grafana upstream used by the /api/grafana proxy (docker network hostname).
GRAFANA_URL=http://grafana:3000

# MediaMTX WebRTC additional hosts (for local development)
MTX_WEBRTCADDITIONALHOSTS=localhost
